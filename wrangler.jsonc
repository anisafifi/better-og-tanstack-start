{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "better-og",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"placement": {
		"mode": "smart"
	},
	"routes": [
		{
			"pattern": "www.anisafifi.com/og*",
			"zone_name": "anisafifi.com"
		},
		{
			"pattern": "www.xerobi.com/og*",
			"zone_name": "xerobi.com"
		}
	]
}